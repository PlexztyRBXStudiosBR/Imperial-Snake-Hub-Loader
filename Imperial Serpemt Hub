-- AIMBOT SYSTEM (Sistema de Aimbot)
-- ═══════════════════════════════════════════════════════════════════════════
local AimbotSystem = {}
AimbotSystem.Config = {
    TeamCheck = false,
    WallCheck = false,
    MaxDistance = 500,
    AimPart = "Head",
    Smoothness = 0.5,
}

function AimbotSystem:GetClosestPlayer()
    local closest = nil
    local closestDist = self.Config.MaxDistance
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local part = player.Character:FindFirstChild(self.Config.AimPart)
            if part then
                if self.Config.TeamCheck and player.Team == LocalPlayer.Team then
                    continue
                end
                
                local screenPos, onScreen = Camera:WorldToScreenPoint(part.Position)
                if onScreen then
                    local mousePos = UserInputService:GetMouseLocation()
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    
                    if dist < closestDist then
                        closest = player
                        closestDist = dist
                    end
                end
            end
        end
    end
    
    return closest
end

function AimbotSystem:EnableAimbot()
    IS.State.Aimbot = true
    
    IS.Connections.Aimbot = RunService.RenderStepped:Connect(function()
        if not IS.State.Aimbot then return end
        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        
        local target = self:GetClosestPlayer()
        if target and target.Character then
            local aimPart = target.Character:FindFirstChild(self.Config.AimPart)
            if aimPart then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPart.Position)
            end
        end
    end)
end

function AimbotSystem:DisableAimbot()
    IS.State.Aimbot = false
    if IS.Connections.Aimbot then
        IS.Connections.Aimbot:Disconnect()
        IS.Connections.Aimbot = nil
    end
end

