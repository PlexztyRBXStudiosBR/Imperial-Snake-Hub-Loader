-- SEÇÃO 6: FUNÇÕES DE COMBATE
-- ════════════════════════════════════════════════════════════════════════════

local function fling(meuChar, alvoChar, intensidade)
    if not meuChar or not alvoChar then return false end
    
    local meuHRP = meuChar:FindFirstChild("HumanoidRootPart")
    local alvoHRP = alvoChar:FindFirstChild("HumanoidRootPart")
    
    if not meuHRP or not alvoHRP then return false end
    
    local posOriginal = meuHRP.CFrame
    local direcao = (alvoHRP.Position - meuHRP.Position).Unit
    local forca = intensidade or 50
    
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = direcao * forca * 2
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Parent = meuHRP
    
    local bav = Instance.new("BodyAngularVelocity")
    bav.AngularVelocity = Vector3.new(
        math.random(-100, 100),
        math.random(-100, 100),
        math.random(-100, 100)
    )
    bav.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bav.Parent = meuHRP
    
    task.wait(0.2)
    
    pcall(function()
        bv:Destroy()
        bav:Destroy()
    end)
    
    meuHRP.CFrame = posOriginal
    return true
end

local function tocarAnimacao(char, animId, velocidade, loop)
    if not char or animId == 0 then return nil end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(animId)
    
    local track = humanoid:LoadAnimation(anim)
    track:AdjustSpeed(velocidade or 1)
    track.Looped = loop or false
    track:Play()
    
    StateManager.currentAnimation = track
    return track
end

local function obterTodosOsJogadores()
    local jogadores = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            table.insert(jogadores, p)
        end
    end
    return jogadores
end

