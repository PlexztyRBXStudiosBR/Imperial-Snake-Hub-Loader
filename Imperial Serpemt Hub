-- MORPH SYSTEM (Sistema de Aplicação de Morphs)
-- ═══════════════════════════════════════════════════════════════════════════
local MorphSystem = {}

function MorphSystem:Apply(morphName)
    local character = LocalPlayer.Character
    if not character then return false, "Character not found" end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false, "Humanoid not found" end
    
    local morphData = AssetLibrary.Morphs[morphName]
    if not morphData then return false, "Morph not found: " .. morphName end
    
    -- Criar HumanoidDescription
    local desc = Instance.new("HumanoidDescription")
    
    -- Roupas
    desc.Shirt = morphData.shirtId or 0
    desc.Pants = morphData.pantsId or 0
    desc.GraphicTShirt = morphData.tshirtId or 0
    
    -- Face
    desc.Face = morphData.face or 0
    
    -- Acessórios
    desc.HatAccessory = morphData.hats or ""
    desc.HairAccessory = morphData.hair or ""
    desc.FaceAccessory = morphData.faceAcc or ""
    desc.NeckAccessory = morphData.neck or ""
    desc.ShouldersAccessory = morphData.shoulders or ""
    desc.FrontAccessory = morphData.front or ""
    desc.BackAccessory = morphData.back or ""
    desc.WaistAccessory = morphData.waist or ""
    
    -- Cores do corpo
    desc.HeadColor = morphData.headColor or Color3.fromRGB(255, 220, 180)
    desc.TorsoColor = morphData.torsoColor or Color3.fromRGB(255, 220, 180)
    desc.LeftArmColor = morphData.armColor or morphData.leftArmColor or Color3.fromRGB(255, 220, 180)
    desc.RightArmColor = morphData.armColor or morphData.rightArmColor or Color3.fromRGB(255, 220, 180)
    desc.LeftLegColor = morphData.legColor or morphData.leftLegColor or Color3.fromRGB(255, 220, 180)
    desc.RightLegColor = morphData.legColor or morphData.rightLegColor or Color3.fromRGB(255, 220, 180)
    
    -- Escala
    desc.HeadScale = morphData.headScale or 1
    desc.BodyTypeScale = morphData.bodyType or 0.3
    desc.HeightScale = morphData.height or 1
    desc.WidthScale = morphData.width or 1
    desc.DepthScale = morphData.depth or 1
    desc.ProportionScale = morphData.proportion or 0
    
    -- Animações
    desc.IdleAnimation = morphData.idleAnim or 0
    desc.WalkAnimation = morphData.walkAnim or 0
    desc.RunAnimation = morphData.runAnim or 0
    desc.JumpAnimation = morphData.jumpAnim or 0
    desc.FallAnimation = morphData.fallAnim or 0
    desc.SwimAnimation = morphData.swimAnim or 0
    desc.ClimbAnimation = morphData.climbAnim or 0
    
    -- Aplicar (100% legítimo, servidor replica)
    local success, err = pcall(function()
        humanoid:ApplyDescription(desc)
    end)
    
    if success then
        IS.State.CurrentMorph = morphName
        return true, "Morph applied: " .. morphName
    else
        return false, "Failed to apply: " .. tostring(err)
    end
end

function MorphSystem:Reset()
    local character = LocalPlayer.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    local success = pcall(function()
        local defaultDesc = Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
        humanoid:ApplyDescription(defaultDesc)
    end)
    
    if success then
        IS.State.CurrentMorph = nil
        return true
    end
    return false
end

function MorphSystem:SetFace(faceName)
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local faceId = AssetLibrary.Faces[faceName]
    if not faceId then return end
    
    local desc = humanoid:GetAppliedDescription()
    desc.Face = faceId
    humanoid:ApplyDescription(desc)
    IS.State.CurrentFace = faceName
end

function MorphSystem:SetBodyColor(color)
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local desc = humanoid:GetAppliedDescription()
    desc.HeadColor = color
    desc.TorsoColor = color
    desc.LeftArmColor = color
    desc.RightArmColor = color
    desc.LeftLegColor = color
    desc.RightLegColor = color
    humanoid:ApplyDescription(desc)
end

function MorphSystem:SetScale(scale)
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local desc = humanoid:GetAppliedDescription()
    desc.HeadScale = scale
    desc.HeightScale = scale
    desc.WidthScale = scale
    desc.DepthScale = scale
    humanoid:ApplyDescription(desc)
end

