local AutoRestoreSystem = {}

function AutoRestoreSystem.SaveState()
    -- Salvar estado atual para restaurar depois
    local savedState = {
        morphId = State.morphs.current,
        walkSpeed = State.movement.walkSpeed,
        jumpPower = State.movement.jumpPower,
        gravity = State.movement.gravity,
        godMode = State.movement.godMode,
        fly = State.movement.flyEnabled,
        noclip = State.movement.noclipEnabled,
        timestamp = tick()
    }
    
    return savedState
end

function AutoRestoreSystem.RestoreState(savedState)
    if not savedState then return end
    
    task.wait(1) -- Aguardar character carregar
    
    print("🔄 Restaurando estado...")
    
    -- Restaurar morph
    if savedState.morphId then
        local morph = MorphSystem.GetByID(savedState.morphId)
        if morph then
            MorphSystem.Apply(morph)
        end
    end
    
    -- Restaurar velocidade e pulo
    if savedState.walkSpeed then
        MovementSystem.SetWalkSpeed(savedState.walkSpeed)
    end
    
    if savedState.jumpPower then
        MovementSystem.SetJumpPower(savedState.jumpPower)
    end
    
    if savedState.gravity then
        MovementSystem.SetGravity(savedState.gravity)
    end
    
    -- Restaurar modos
    if savedState.godMode then
        MovementSystem.ToggleGodMode()
    end
    
    if savedState.fly then
        MovementSystem.ToggleFly()
    end
    
    if savedState.noclip then
        MovementSystem.ToggleNoclip()
    end
    
    print("✅ Estado restaurado")
    
    if State.ui.notifications then
        Rayfield:Notify({
