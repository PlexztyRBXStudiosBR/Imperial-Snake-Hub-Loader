-- Tocar animação
function AnimationSystem.Play(animId, speed, loop)
    if not animator or not animator.Parent then
        warn("❌ Animator não encontrado")
        return nil
    end
    
    -- Parar animação atual se existir
    if State.animations.currentTrack then
        State.animations.currentTrack:Stop()
    end
    
    -- Criar nova animação
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(animId)
    
    -- Carregar e tocar
    local track = animator:LoadAnimation(anim)
    track:AdjustSpeed(speed or State.animations.speed)
    track.Looped = loop or false
    track:Play()
    
    State.animations.current = animId
    State.animations.currentTrack = track
    
    print("🎬 Animação tocando: " .. animId)
    
    return track
end

-- Parar animação atual
function AnimationSystem.Stop()
    if State.animations.currentTrack then
        State.animations.currentTrack:Stop()
        State.animations.currentTrack = nil
        State.animations.current = nil
        print("⏹️ Animação parada")
    end
end

