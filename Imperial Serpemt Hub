-- Criar círculo FOV visual
function AimbotSystem.CreateFOVCircle()
    if State.camera.aimbot.fovCircle then
        State.camera.aimbot.fovCircle:Remove()
    end
    
    local circle = Drawing.new("Circle")
    circle.Visible = State.camera.aimbot.fovVisible
    circle.Thickness = 2
    circle.Color = Color3.fromRGB(255, 255, 255)
    circle.Transparency = 1
    circle.NumSides = 64
    circle.Radius = State.camera.aimbot.fov
    circle.Filled = false
    circle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    State.camera.aimbot.fovCircle = circle
    
    -- Atualizar posição do círculo
    RunService.RenderStepped:Connect(function()
        if circle and State.camera.aimbot.fovVisible then
            circle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
            circle.Radius = State.camera.aimbot.fov
            circle.Visible = true
        elseif circle then
            circle.Visible = false
        end
    end)
end

-- Obter alvo mais próximo do crosshair
function AimbotSystem.GetClosestTarget()
    local closestPlayer = nil
    local closestDistance = math.huge
    
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        if targetPlayer ~= player and targetPlayer.Character then
            -- Verificar team check
            if State.camera.aimbot.teamCheck and targetPlayer.Team == player.Team then
                continue
            end
            
            local targetChar = targetPlayer.Character
            local targetPart = targetChar:FindFirstChild(State.camera.aimbot.targetPart)
            
            if targetPart then
                -- Verificar visibility check
                if State.camera.aimbot.visibilityCheck then
                    local ray = Ray.new(camera.CFrame.Position, (targetPart.Position - camera.CFrame.Position).Unit * 1000)
                    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {character})
                    
                    if hit and not hit:IsDescendantOf(targetChar) then
                        continue
                    end
                end
                
                -- Calcular distância do crosshair
                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                
                if onScreen then
                    local centerScreen = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                    local mousePos = Vector2.new(screenPos.X, screenPos.Y)
                    local distance = (centerScreen - mousePos).Magnitude
                    
                    if distance <= State.camera.aimbot.fov and distance < closestDistance then
                        closestDistance = distance
                        closestPlayer = targetPlayer
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

-- Atualizar câmera para mirar no alvo
function AimbotSystem.UpdateCamera()
    if not State.camera.aimbot.enabled then return end
    
    -- Verificar se a tecla está sendo pressionada
    if State.camera.aimbot.aimKeyHold then
        if not UserInputService:IsMouseButtonPressed(State.camera.aimbot.aimKey) then
            return
        end
    end
    
    local target = AimbotSystem.GetClosestTarget()
    
    if target and target.Character then
        State.camera.aimbot.target = target
        
        local targetPart = target.Character:FindFirstChild(State.camera.aimbot.targetPart)
        
        if targetPart then
            local targetPos = targetPart.Position
            
            -- Aplicar predição se ativado
            if State.camera.aimbot.prediction then
                local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    local velocity = targetHRP.AssemblyVelocity
                    targetPos = targetPos + (velocity * State.camera.aimbot.predictionAmount)
                end
            end
            
            -- Calcular nova direção da câmera
            local newCFrame = CFrame.new(camera.CFrame.Position, targetPos)
            
            -- Aplicar smoothing
            if State.camera.aimbot.smoothing > 0 then
                camera.CFrame = camera.CFrame:Lerp(newCFrame, State.camera.aimbot.smoothing)
            else
                camera.CFrame = newCFrame
            end
            
            -- Atualizar stats
            State.camera.aimbot.shots = State.camera.aimbot.shots + 1
        end
    else
        State.camera.aimbot.target = nil
    end
end

-- Ativar/Desativar Aimbot
function AimbotSystem.Toggle()
    State.camera.aimbot.enabled = not State.camera.aimbot.enabled
    
    if State.camera.aimbot.enabled then
        print("🎯 Aimbot ativado")
        
        -- Criar círculo FOV
        AimbotSystem.CreateFOVCircle()
        
        -- Iniciar loop de aim
        State.camera.aimbot.updateConnection = RunService.RenderStepped:Connect(function()
            AimbotSystem.UpdateCamera()
        end)
        
        if State.ui.notifications then
            Rayfield:Notify({
                Title = "🎯 Aimbot",
                Content = "Ativado! Mira automática",
                Duration = 2
            })
        end
        
    else
        print("❌ Aimbot desativado")
        
        if State.camera.aimbot.updateConnection then
            State.camera.aimbot.updateConnection:Disconnect()
        end
        
        if State.camera.aimbot.fovCircle then
            State.camera.aimbot.fovCircle.Visible = false
        end
        
        State.camera.aimbot.target = nil
    end
end

