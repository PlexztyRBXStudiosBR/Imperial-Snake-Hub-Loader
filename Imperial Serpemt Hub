function ESPSystem:EnableESP()
    IS.State.ESP = true
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            self:CreateESP(player)
        end
    end
    
    IS.Connections.ESP = Players.PlayerAdded:Connect(function(player)
        if IS.State.ESP then
            player.CharacterAdded:Connect(function()
                task.wait(1)
                self:CreateESP(player)
            end)
        end
    end)
    
    IS.Connections.ESPRespawn = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(IS.Connections.ESPRespawn, player.CharacterAdded:Connect(function()
                task.wait(1)
                if IS.State.ESP then
                    self:CreateESP(player)
                end
            end))
        end
    end
end

function ESPSystem:DisableESP()
    IS.State.ESP = false
    
    if IS.Connections.ESP then
        IS.Connections.ESP:Disconnect()
        IS.Connections.ESP = nil
    end
    
    if IS.Connections.ESPRespawn then
        for _, conn in ipairs(IS.Connections.ESPRespawn) do
            conn:Disconnect()
        end
        IS.Connections.ESPRespawn = {}
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                local esp = head:FindFirstChild("ImperialESP")
                if esp then esp:Destroy() end
            end
            local highlight = player.Character:FindFirstChild("ImperialHighlight")
            if highlight then highlight:Destroy() end
        end
    end
end

