-- FLING SYSTEM (COMPLETO)
-- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

function CombatSystem.Fling(target, power)
    if not target or not target.Character then
        warn("❌ Alvo inválido")
        return false
    end
    
    local targetChar = target.Character
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    
    if not targetHRP then
        warn("❌ HRP do alvo não encontrado")
        return false
    end
    
    -- Verificar cooldown
    if tick() - State.combat.lastFling < State.combat.flingCooldown then
        warn("⚠️ Aguarde o cooldown")
        return false
    end
    
    State.combat.lastFling = tick()
    
    -- Salvar posição original
    local origPos = hrp.CFrame
    
    -- Calcular direção
    local direction = (targetHRP.Position - hrp.Position).Unit
    local forcePower = power or State.combat.flingPower
    
    -- Criar BodyVelocity
    local bv = Instance.new("BodyVelocity")
    bv.Name = "ImperialFling"
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = direction * forcePower * 2
    bv.Parent = hrp
    
    -- Criar BodyAngularVelocity para rotação
    local bav = Instance.new("BodyAngularVelocity")
    bav.Name = "ImperialFlingRotation"
    bav.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bav.AngularVelocity = Vector3.new(
        math.random(-100, 100),
        math.random(-100, 100),
        math.random(-100, 100)
    )
    bav.Parent = hrp
    
    -- Aguardar impacto
    task.wait(0.2)
    
    -- Limpar
    pcall(function()
        bv:Destroy()
        bav:Destroy()
    end)
    
    -- Voltar à posição original
    hrp.CFrame = origPos
    
    -- Atualizar stats
    State.combat.attacksUsed = State.combat.attacksUsed + 1
    State.stats.attacksUsed = State.stats.attacksUsed + 1
    
    print("💥 Fling aplicado em " .. target.Name .. " com poder " .. forcePower)
    
    return true
end

