-- MOVEMENT SYSTEM (Sistema de Movimento)
-- ═══════════════════════════════════════════════════════════════════════════
local MovementSystem = {}

function MovementSystem:SetWalkSpeed(speed)
    if Humanoid then
        Humanoid.WalkSpeed = speed
        IS.State.CustomWalkSpeed = speed
    end
end

function MovementSystem:SetJumpPower(power)
    if Humanoid then
        Humanoid.JumpPower = power
        Humanoid.UseJumpPower = true
        IS.State.CustomJumpPower = power
    end
end

function MovementSystem:SetHipHeight(height)
    if Humanoid then
        Humanoid.HipHeight = height
        IS.State.CustomHipHeight = height
    end
end

function MovementSystem:EnableFly(speed)
    speed = speed or 50
    local character = LocalPlayer.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    self:DisableFly()
    
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Parent = hrp
    
    local bg = Instance.new("BodyGyro")
    bg.CFrame = hrp.CFrame
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 1e4
    bg.Parent = hrp
    
    IS.Objects.FlyVelocity = bv
    IS.Objects.FlyGyro = bg
    IS.State.Fly = true
    
    IS.Connections.Fly = RunService.RenderStepped:Connect(function()
        if not IS.State.Fly then return end
        
        local cam = Camera.CFrame
        local moveVector = Vector3.new(0, 0, 0)
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveVector = moveVector + cam.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveVector = moveVector - cam.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveVector = moveVector - cam.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveVector = moveVector + cam.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveVector = moveVector + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveVector = moveVector - Vector3.new(0, 1, 0)
        end
        
        if IS.Objects.FlyVelocity then
            IS.Objects.FlyVelocity.Velocity = moveVector * speed
        end
        if IS.Objects.FlyGyro then
            IS.Objects.FlyGyro.CFrame = cam
        end
    end)
end

function MovementSystem:DisableFly()
    IS.State.Fly = false
    
    if IS.Connections.Fly then
        IS.Connections.Fly:Disconnect()
        IS.Connections.Fly = nil
    end
    
    if IS.Objects.FlyVelocity then
        IS.Objects.FlyVelocity:Destroy()
        IS.Objects.FlyVelocity = nil
    end
    if IS.Objects.FlyGyro then
        IS.Objects.FlyGyro:Destroy()
        IS.Objects.FlyGyro = nil
    end
end

function MovementSystem:EnableNoclip()
    IS.State.Noclip = true
    
    IS.Connections.Noclip = RunService.Stepped:Connect(function()
        if not IS.State.Noclip then return end
        local character = LocalPlayer.Character
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

function MovementSystem:DisableNoclip()
    IS.State.Noclip = false
    if IS.Connections.Noclip then
        IS.Connections.Noclip:Disconnect()
        IS.Connections.Noclip = nil
    end
end

function MovementSystem:EnableInfiniteJump()
    IS.State.InfiniteJump = true
    
    IS.Connections.InfJump = UserInputService.JumpRequest:Connect(function()
        if IS.State.InfiniteJump then
            local character = LocalPlayer.Character
            if character then
                local hum = character:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end
    end)
end

function MovementSystem:DisableInfiniteJump()
    IS.State.InfiniteJump = false
    if IS.Connections.InfJump then
        IS.Connections.InfJump:Disconnect()
        IS.Connections.InfJump = nil
    end
end

function MovementSystem:TeleportTo(targetChar)
    local character = LocalPlayer.Character
    if not character or not targetChar then return end
    
    local myHRP = character:FindFirstChild("HumanoidRootPart")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    
    if myHRP and targetHRP then
        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
    end
end

function MovementSystem:TeleportToPlayer(playerName)
    local player = Players:FindFirstChild(playerName)
    if player and player.Character then
        self:TeleportTo(player.Character)
    end
end

