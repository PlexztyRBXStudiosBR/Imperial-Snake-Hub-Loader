-- COMBAT SYSTEM (Sistema de Combate)
-- ═══════════════════════════════════════════════════════════════════════════
local CombatSystem = {}

function CombatSystem:Fling(targetChar, power, duration)
    local myChar = LocalPlayer.Character
    if not myChar or not targetChar then return false end
    
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not myHRP or not targetHRP then return false end
    
    power = power or 50
    duration = duration or 0.15
    
    local originalCFrame = myHRP.CFrame
    local direction = (targetHRP.Position - myHRP.Position).Unit
    
    -- BodyVelocity para lançar
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = direction * power * 100
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Parent = myHRP
    
    -- BodyAngularVelocity para rotação (mais impacto)
    local bav = Instance.new("BodyAngularVelocity")
    bav.AngularVelocity = Vector3.new(
        math.random(-50, 50),
        math.random(-50, 50),
        math.random(-50, 50)
    )
    bav.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bav.Parent = myHRP
    
    task.wait(duration)
    
    bv:Destroy()
    bav:Destroy()
    myHRP.CFrame = originalCFrame
    
    return true
end

function CombatSystem:FlingAll(power)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            task.spawn(function()
                self:Fling(player.Character, power)
            end)
            task.wait(0.2)
        end
    end
end

function CombatSystem:PlaySkill(skillName, speed, loop)
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local animId = AssetLibrary.Animations[skillName]
    if not animId then return end
    
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(animId)
    
    local track = humanoid:LoadAnimation(anim)
    track:AdjustSpeed(speed or 1)
    track.Looped = loop or false
    track:Play()
    
    IS.State.ActiveAnimations[skillName] = track
    return track
end

function CombatSystem:StopSkill(skillName)
    if IS.State.ActiveAnimations[skillName] then
        IS.State.ActiveAnimations[skillName]:Stop()
        IS.State.ActiveAnimations[skillName] = nil
    end
end

function CombatSystem:StopAllSkills()
    for name, track in pairs(IS.State.ActiveAnimations) do
        track:Stop()
    end
    IS.State.ActiveAnimations = {}
end

function CombatSystem:Punch(targetChar)
    self:PlaySkill("Jab", 1.5, false)
    task.wait(0.1)
    if targetChar then
        self:Fling(targetChar, 20, 0.1)
    end
end

function CombatSystem:Combo(targetChar, comboType)
    comboType = comboType or "Combo3"
    self:PlaySkill(comboType, 1.5, false)
    
    for i = 1, 3 do
        task.wait(0.15)
        if targetChar then
            self:Fling(targetChar, 15, 0.08)
        end
    end
end

function CombatSystem:UltimateAttack(targetChar, skillName)
    self:PlaySkill(skillName or "Kamehameha", 1, false)
    task.wait(1)
    if targetChar then
        self:Fling(targetChar, 200, 0.3)
    end
end

