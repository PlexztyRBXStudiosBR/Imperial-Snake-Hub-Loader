print("🔄 Carregando sistema de keybinds...")

local KeybindSystem = {}

-- Função para processar input
function KeybindSystem.ProcessInput(input, gameProcessed)
    if gameProcessed then return end
    
    -- Toggle UI
    if input.KeyCode == State.ui.keybinds.toggleUI then
        Rayfield:Toggle()
        return
    end
    
    -- Fly
    if input.KeyCode == State.ui.keybinds.fly then
        MovementSystem.ToggleFly()
        return
    end
    
    -- Noclip
    if input.KeyCode == State.ui.keybinds.noclip then
        MovementSystem.ToggleNoclip()
        return
    end
    
    -- God Mode
    if input.KeyCode == State.ui.keybinds.godMode then
        MovementSystem.ToggleGodMode()
        return
    end
    
    -- ESP
    if input.KeyCode == State.ui.keybinds.esp then
        ESPSystem.Toggle()
        return
    end
    
    -- Panic (fechar tudo)
    if input.KeyCode == State.ui.keybinds.panic then
        -- Desativar todas as features
        if State.movement.flyEnabled then MovementSystem.ToggleFly() end
        if State.movement.noclipEnabled then MovementSystem.ToggleNoclip() end
        if State.movement.godMode then MovementSystem.ToggleGodMode() end
        if State.visuals.esp.enabled then ESPSystem.Toggle() end
        if State.camera.aimbot.enabled then AimbotSystem.Toggle() end
        
        -- Fechar UI
        Rayfield:Destroy()
        
        Rayfield:Notify({
            Title = "⚠️ PANIC MODE",
            Content = "Todas as features desativadas!",
            Duration = 2
        })
        return
    end
    
    -- Dash (Shift + Direção)
    if input.KeyCode == Enum.KeyCode.LeftShift and State.movement.dash then
        local direction = hrp.CFrame.LookVector
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction = hrp.CFrame.LookVector
        elseif UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction = -hrp.CFrame.LookVector
        elseif UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction = -hrp.CFrame.RightVector
        elseif UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction = hrp.CFrame.RightVector
        end
        
        MovementSystem.Dash(direction)
        return
    end
end

-- Conectar input
UserInputService.InputBegan:Connect(KeybindSystem.ProcessInput)

