-- ════════════════════════════════════════════════════════════════════════════

player.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoid = character:FindFirstChildOfClass("Humanoid")
    humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    
    task.wait(1)
    
    -- Restaurar morph
    if StateManager.morphAtivo then
        for morphKey, morphData in pairs(AssetCatalog.morphs) do
            if morphData.name == StateManager.morphAtivo then
                aplicarMorph(character, morphData)
                break
            end
        end
    end
    
    -- Restaurar velocidade
