local MorphSystem = {}

-- Função principal de aplicar morph
function MorphSystem.Apply(morphData)
    if not morphData then 
        warn("❌ MorphData inválido")
        return false 
    end
    
    if not humanoid or not humanoid.Parent then
        warn("❌ Humanoid não encontrado")
        return false
    end
    
    -- Verificar cooldown
    if State.morphs.lastApply and (tick() - State.morphs.lastApply) < 0.5 then
        warn("⚠️ Aguarde antes de trocar de morph")
        return false
    end
    
    print("🔄 Aplicando morph: " .. morphData.name)
    
    -- Criar nova description
    local desc = Instance.new("HumanoidDescription")
    
    -- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    -- APLICAR ROUPAS E ACESSÓRIOS
    -- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    
    if morphData.shirtId and morphData.shirtId ~= 0 then
        desc.Shirt = morphData.shirtId
    end
    
    if morphData.pantsId and morphData.pantsId ~= 0 then
        desc.Pants = morphData.pantsId
    end
    
    if morphData.faceId and morphData.faceId ~= 0 then
        desc.Face = morphData.faceId
    end
    
    -- Acessórios
    if morphData.hats and morphData.hats ~= "" then
        desc.HatAccessory = morphData.hats
    end
    
    if morphData.hair and morphData.hair ~= "" then
        desc.HairAccessory = morphData.hair
    end
    
    if morphData.back and morphData.back ~= "" then
        desc.BackAccessory = morphData.back
    end
    
    if morphData.neck and morphData.neck ~= "" then
        desc.NeckAccessory = morphData.neck
    end
    
    if morphData.front and morphData.front ~= "" then
        desc.FrontAccessory = morphData.front
    end
    
    if morphData.waist and morphData.waist ~= "" then
        desc.WaistAccessory = morphData.waist
    end
    
    if morphData.shoulders and morphData.shoulders ~= "" then
        desc.ShouldersAccessory = morphData.shoulders
    end
    
    if morphData.faceAccessory and morphData.faceAccessory ~= "" then
        desc.FaceAccessory = morphData.faceAccessory
    end
    
    -- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    -- APLICAR CORES DO CORPO
    -- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    
    desc.HeadColor = morphData.headColor or Color3.fromRGB(255, 220, 180)
    desc.TorsoColor = morphData.torsoColor or morphData.headColor or Color3.fromRGB(255, 220, 180)
    desc.LeftArmColor = morphData.armColor or morphData.headColor or Color3.fromRGB(255, 220, 180)
    desc.RightArmColor = morphData.armColor or morphData.headColor or Color3.fromRGB(255, 220, 180)
    desc.LeftLegColor = morphData.legColor or morphData.headColor or Color3.fromRGB(200, 180, 150)
    desc.RightLegColor = morphData.legColor or morphData.headColor or Color3.fromRGB(200, 180, 150)
    
    -- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    -- APLICAR ESCALAS DO CORPO
    -- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    
    desc.HeadScale = math.clamp(morphData.headScale or 1, 0.5, 1.5)
    desc.HeightScale = math.clamp(morphData.heightScale or 1, 0.5, 1.5)
    desc.WidthScale = math.clamp(morphData.widthScale or (morphData.heightScale or 1) * 0.8, 0.5, 1.5)
    desc.DepthScale = math.clamp(morphData.depthScale or (morphData.heightScale or 1) * 0.8, 0.5, 1.5)
    desc.BodyTypeScale = math.clamp(morphData.bodyTypeScale or 0.3, 0, 1)
    
    -- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    -- APLICAR ANIMAÇÕES
    -- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    
    if morphData.idleAnim and morphData.idleAnim ~= 0 then
        desc.IdleAnimation = morphData.idleAnim
    end
    
    if morphData.walkAnim and morphData.walkAnim ~= 0 then
        desc.WalkAnimation = morphData.walkAnim
    end
    
    if morphData.runAnim and morphData.runAnim ~= 0 then
        desc.RunAnimation = morphData.runAnim
    end
    
    if morphData.jumpAnim and morphData.jumpAnim ~= 0 then
        desc.JumpAnimation = morphData.jumpAnim
    end
    
    if morphData.fallAnim and morphData.fallAnim ~= 0 then
        desc.FallAnimation = morphData.fallAnim
    end
    
    if morphData.swimAnim and morphData.swimAnim ~= 0 then
        desc.SwimAnimation = morphData.swimAnim
    end
    
    if morphData.climbAnim and morphData.climbAnim ~= 0 then
        desc.ClimbAnimation = morphData.climbAnim
    end
    
    -- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    -- APLICAR DESCRIPTION
    -- ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    
    local success = pcall(function()
        humanoid:ApplyDescription(desc)
    end)
    
    if success then
        -- Atualizar estado
        State.morphs.previous = State.morphs.current
        State.morphs.current = morphData.id
        State.morphs.lastApply = tick()
        
        -- Adicionar ao histórico
        table.insert(State.morphs.history, 1, {
            id = morphData.id,
            name = morphData.name,
            timestamp = tick(),
            category = morphData.category
        })
        
        -- Limitar histórico a 50
        if #State.morphs.history > 50 then
            table.remove(State.morphs.history, 51)
        end
        
        -- Atualizar recently used
        local found = false
        for i, recentMorph in ipairs(State.morphs.recentlyUsed) do
            if recentMorph.id == morphData.id then
                recentMorph.count = recentMorph.count + 1
                recentMorph.lastUsed = tick()
                found = true
                break
            end
        end
        
        if not found then
            table.insert(State.morphs.recentlyUsed, {
                id = morphData.id,
                name = morphData.name,
                count = 1,
                lastUsed = tick()
            })
        end
        
        -- Atualizar stats
        State.stats.morphsUsed = State.stats.morphsUsed + 1
        
        print("✅ Morph aplicado com sucesso: " .. morphData.name)
        return true
    else
        warn("❌ Falha ao aplicar morph")
        return false
    end
end

-- Função para remover morph (voltar ao padrão)
function MorphSystem.Remove()
    local desc = Instance.new("HumanoidDescription")
    
    -- Resetar para valores padrão
    desc.HeadColor = Color3.fromRGB(255, 220, 180)
    desc.TorsoColor = Color3.fromRGB(255, 220, 180)
    desc.LeftArmColor = Color3.fromRGB(255, 220, 180)
    desc.RightArmColor = Color3.fromRGB(255, 220, 180)
    desc.LeftLegColor = Color3.fromRGB(200, 180, 150)
    desc.RightLegColor = Color3.fromRGB(200, 180, 150)
    
    desc.HeadScale = 1
    desc.HeightScale = 1
    desc.WidthScale = 1
    desc.DepthScale = 1
    desc.BodyTypeScale = 0.3
    
    pcall(function()
        humanoid:ApplyDescription(desc)
    end)
    
    State.morphs.current = nil
    print("✅ Morph removido")
end

-- Função para buscar morph por ID
function MorphSystem.GetByID(id)
    for _, morph in ipairs(MorphDatabase) do
        if morph.id == id then
            return morph
        end
    end
    return nil
end

-- Função para buscar morphs por categoria
function MorphSystem.GetByCategory(category)
    local results = {}
    for _, morph in ipairs(MorphDatabase) do
        if morph.category == category then
            table.insert(results, morph)
        end
    end
    return results
end

-- Função para buscar morphs por rarity
function MorphSystem.GetByRarity(rarity)
    local results = {}
    for _, morph in ipairs(MorphDatabase) do
        if morph.rarity == rarity then
            table.insert(results, morph)
        end
    end
    return results
end

-- Função para adicionar morph aos favoritos
function MorphSystem.AddFavorite(morphId)
    if not table.find(State.morphs.favorites, morphId) then
        table.insert(State.morphs.favorites, morphId)
        print("⭐ Morph adicionado aos favoritos")
        return true
    end
    return false
end

-- Função para remover dos favoritos
function MorphSystem.RemoveFavorite(morphId)
    local index = table.find(State.morphs.favorites, morphId)
    if index then
        table.remove(State.morphs.favorites, index)
        print("❌ Morph removido dos favoritos")
        return true
    end
    return false
end

