local LogSystem = {}

-- Função de log
function LogSystem.Log(message, logType)
    local timestamp = os.date("%H:%M:%S")
    local prefix = ""
    
    if logType == "info" then
        prefix = "ℹ️ [INFO]"
    elseif logType == "warning" then
        prefix = "⚠️ [WARN]"
    elseif logType == "error" then
        prefix = "❌ [ERROR]"
    elseif logType == "combat" then
        prefix = "⚔️ [COMBAT]"
    elseif logType == "player" then
        prefix = "👤 [PLAYER]"
    elseif logType == "system" then
        prefix = "🔧 [SYSTEM]"
    else
        prefix = "📝 [LOG]"
    end
    
    local fullMessage = string.format("[%s] %s %s", timestamp, prefix, message)
    
    -- Print no console
    print(fullMessage)
    
    -- Adicionar ao array de logs
    if State.ui.logTypes[logType] then
        table.insert(State.ui.logs, {
            timestamp = timestamp,
            type = logType,
            message = message,
            full = fullMessage
        })
        
        -- Limitar logs
        if #State.ui.logs > State.ui.maxLogs then
            table.remove(State.ui.logs, 1)
        end
    end
end

-- Atalhos
function LogSystem.Info(msg) LogSystem.Log(msg, "info") end
function LogSystem.Warning(msg) LogSystem.Log(msg, "warning") end
function LogSystem.Error(msg) LogSystem.Log(msg, "error") end
function LogSystem.Combat(msg) LogSystem.Log(msg, "combat") end
function LogSystem.Player(msg) LogSystem.Log(msg, "player") end
