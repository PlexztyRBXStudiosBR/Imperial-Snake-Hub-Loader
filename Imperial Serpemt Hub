function LogSystem.Export()
    local logText = "═══════════════════════════════════════════════════════\n"
    logText = logText .. "IMPERIAL SERPENT - LOG EXPORT\n"
    logText = logText .. "═══════════════════════════════════════════════════════\n\n"
    
    for _, log in ipairs(State.ui.logs) do
        logText = logText .. log.full .. "\n"
    end
    
    logText = logText .. "\n═══════════════════════════════════════════════════════\n"
    logText = logText .. "Total de logs: " .. #State.ui.logs .. "\n"
    logText = logText .. "═══════════════════════════════════════════════════════\n"
    
    -- Copiar para clipboard se possível
    if setclipboard then
        setclipboard(logText)
        NotificationSystem.Success("Logs copiados para clipboard!")
    else
        print(logText)
        NotificationSystem.Info("Logs impressos no console")
    end
