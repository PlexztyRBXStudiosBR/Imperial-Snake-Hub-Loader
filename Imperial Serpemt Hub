function AutoRestoreSystem:Setup()
    IS.Connections.CharacterAdded = LocalPlayer.CharacterAdded:Connect(function(newCharacter)
        task.wait(1)
        
        -- Atualizar referências globais
        Character = newCharacter
        Humanoid = newCharacter:WaitForChild("Humanoid")
        HRP = newCharacter:WaitForChild("HumanoidRootPart")
        
        if not IS.State.AutoRestore then return end
        
        -- Restaurar morph
        if IS.State.CurrentMorph then
            task.wait(0.5)
            MorphSystem:Apply(IS.State.CurrentMorph)
        end
        
        -- Restaurar face
        if IS.State.CurrentFace then
            task.wait(0.5)
            MorphSystem:SetFace(IS.State.CurrentFace)
        end
        
        -- Restaurar velocidade
        if IS.State.CustomWalkSpeed then
            MovementSystem:SetWalkSpeed(IS.State.CustomWalkSpeed)
        end
        
        -- Restaurar pulo
        if IS.State.CustomJumpPower then
            MovementSystem:SetJumpPower(IS.State.CustomJumpPower)
        end
        
        -- Restaurar altura do quadril
        if IS.State.CustomHipHeight then
            MovementSystem:SetHipHeight(IS.State.CustomHipHeight)
        end
        
        -- Restaurar god mode
        if IS.State.GodMode then
            SurvivalSystem:EnableGodMode()
        end
        
        -- Restaurar fly
        if IS.State.Fly then
            MovementSystem:EnableFly()
        end
        
        -- Restaurar noclip
        if IS.State.Noclip then
            MovementSystem:EnableNoclip()
        end
        
        -- Restaurar infinite jump
        if IS.State.InfiniteJump then
            MovementSystem:EnableInfiniteJump()
        end
        
        print("[👑 Imperial Serpent] Auto-restore complete!")
    end)
end

