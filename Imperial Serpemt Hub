-- SEÇÃO 7: FUNÇÕES DE MOVIMENTO
-- ════════════════════════════════════════════════════════════════════════════

local flyActive = false
local flySpeed = 50

local function ativarFly(char)
    if flyActive or not char then return end
    flyActive = true
    StateManager.flyAtivo = true
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local camera = Workspace.CurrentCamera
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = hrp
    
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bodyGyro.D = 500
    bodyGyro.Parent = hrp
    
    local conexao
    conexao = RunService.RenderStepped:Connect(function()
        if not flyActive or not hrp or not hrp.Parent then
            pcall(function()
                bodyVelocity:Destroy()
                bodyGyro:Destroy()
            end)
            conexao:Disconnect()
            flyActive = false
            StateManager.flyAtivo = false
            return
        end
        
        local moveDirection = Vector3.new(0, 0, 0)
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            moveDirection = moveDirection - Vector3.new(0, 1, 0)
        end
        
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit
        end
        
        bodyVelocity.Velocity = moveDirection * flySpeed
        bodyGyro.CFrame = camera.CFrame
    end)
end

local function desativarFly()
    flyActive = false
    StateManager.flyAtivo = false
end

local noclipActive = false

local function ativarNoclip(char)
    if noclipActive or not char then return end
    noclipActive = true
    StateManager.noclipAtivo = true
    
    local conexao
    conexao = RunService.Stepped:Connect(function()
        if not noclipActive or not char or not char.Parent then
            conexao:Disconnect()
            noclipActive = false
            StateManager.noclipAtivo = false
            return
        end
        
        for _, part in char:GetDescendants() do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

local function desativarNoclip()
    noclipActive = false
    StateManager.noclipAtivo = false
    
    for _, part in character:GetDescendants() do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

local godModeActive = false

local function ativarGodMode(char)
    if godModeActive or not char then return end
    godModeActive = true
    StateManager.godMode = true
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local conexao
    conexao = RunService.Heartbeat:Connect(function()
        if not godModeActive or not humanoid or not humanoid.Parent then
            conexao:Disconnect()
            godModeActive = false
            StateManager.godMode = false
            return
        end
        
        if humanoid.Health < humanoid.MaxHealth then
            humanoid.Health = humanoid.MaxHealth
        end
    end)
end

local function desativarGodMode()
    godModeActive = false
    StateManager.godMode = false
end

