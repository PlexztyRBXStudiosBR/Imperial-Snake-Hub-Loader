local SecuritySystem = {}

-- Anti-Kick
function SecuritySystem.EnableAntiKick()
    if not State.security.antiKick then return end
    
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if method == "Kick" then
            LogSystem.Warning("Tentativa de kick bloqueada!")
            NotificationSystem.Warning("Kick bloqueado!")
            return wait(9e9)
        end
        
        return oldNamecall(self, ...)
    end)
    
    setreadonly(mt, true)
    
    LogSystem.Info("Anti-Kick ativado")
end

-- Anti-Ban (tentar)
function SecuritySystem.EnableAntiBan()
    if not State.security.antiBan then return end
    
    -- Bloquear tentativas de ban via RemoteEvents
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if method == "FireServer" or method == "InvokeServer" then
            if tostring(self):lower():find("ban") or 
               tostring(self):lower():find("anticheat") or
               tostring(self):lower():find("security") then
                LogSystem.Warning("Chamada suspeita bloqueada: " .. tostring(self))
                return wait(9e9)
            end
        end
        
        return oldNamecall(self, ...)
    end)
    
    setreadonly(mt, true)
    
    LogSystem.Info("Anti-Ban ativado")
end

