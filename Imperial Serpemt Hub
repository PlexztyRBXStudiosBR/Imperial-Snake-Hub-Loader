-- Loop principal de atualização
spawn(function()
    while true do
        task.wait(1)
        
        -- Atualizar duração da sessão
        State.stats.sessionDuration = tick() - State.stats.sessionStart
        
        -- Auto GC
        if State.system.autoGC then
            if (tick() % State.system.gcInterval) < 1 then
                collectgarbage("collect")
            end
        end
        
        -- Cleanup de ESP
        if State.visuals.esp.enabled then
            ESPSystem.CleanUp()
        end
    end
end)

