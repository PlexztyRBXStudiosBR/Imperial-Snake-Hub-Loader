local ESPSystem = {}

-- Criar ESP para um jogador específico
function ESPSystem.CreatePlayerESP(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then
        return nil
    end
    
    local char = targetPlayer.Character
    local hrpTarget = char:FindFirstChild("HumanoidRootPart")
    local humanoidTarget = char:FindFirstChildOfClass("Humanoid")
    
    if not hrpTarget then
        return nil
    end
    
    -- Criar Highlight
    local highlight = Instance.new("Highlight")
    highlight.Name = "ImperialESP_Highlight"
    highlight.Adornee = char
    highlight.FillColor = State.visuals.esp.color
    highlight.OutlineColor = State.visuals.esp.color
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = char
    
    -- Criar BillboardGui para informações
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ImperialESP_Billboard"
    billboard.Adornee = hrpTarget
    billboard.Size = UDim2.new(0, 200, 0, 150)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = hrpTarget
    
    -- Frame container
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.Parent = billboard
    
    -- Nome do jogador
    if State.visuals.esp.names then
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name = "NameLabel"
        nameLabel.Size = UDim2.new(1, 0, 0, 20)
        nameLabel.Position = UDim2.new(0, 0, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = targetPlayer.Name
        nameLabel.TextColor3 = State.visuals.esp.color
        nameLabel.TextStrokeTransparency = 0.5
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Parent = frame
    end
    
    -- Vida
    if State.visuals.esp.health and humanoidTarget then
        local healthLabel = Instance.new("TextLabel")
        healthLabel.Name = "HealthLabel"
        healthLabel.Size = UDim2.new(1, 0, 0, 20)
        healthLabel.Position = UDim2.new(0, 0, 0, 25)
        healthLabel.BackgroundTransparency = 1
        healthLabel.Text = "HP: " .. math.floor(humanoidTarget.Health) .. "/" .. math.floor(humanoidTarget.MaxHealth)
        healthLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        healthLabel.TextStrokeTransparency = 0.5
        healthLabel.TextSize = 12
        healthLabel.Font = Enum.Font.Gotham
        healthLabel.Parent = frame
        
        -- Atualizar vida continuamente
        local healthConnection
        healthConnection = humanoidTarget.HealthChanged:Connect(function()
            if healthLabel and healthLabel.Parent then
                healthLabel.Text = "HP: " .. math.floor(humanoidTarget.Health) .. "/" .. math.floor(humanoidTarget.MaxHealth)
                
                -- Cor baseada na vida
                local healthPercent = humanoidTarget.Health / humanoidTarget.MaxHealth
                if healthPercent > 0.5 then
                    healthLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                elseif healthPercent > 0.25 then
                    healthLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
                else
                    healthLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                end
            else
                healthConnection:Disconnect()
            end
        end)
    end
    
    -- Distância
    if State.visuals.esp.distance then
        local distanceLabel = Instance.new("TextLabel")
        distanceLabel.Name = "DistanceLabel"
        distanceLabel.Size = UDim2.new(1, 0, 0, 20)
        distanceLabel.Position = UDim2.new(0, 0, 0, 50)
        distanceLabel.BackgroundTransparency = 1
        distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        distanceLabel.TextStrokeTransparency = 0.5
        distanceLabel.TextSize = 12
        distanceLabel.Font = Enum.Font.Gotham
        distanceLabel.Parent = frame
        
        -- Atualizar distância continuamente
        local distanceConnection
        distanceConnection = RunService.RenderStepped:Connect(function()
            if distanceLabel and distanceLabel.Parent and hrpTarget and hrp then
                local distance = (hrpTarget.Position - hrp.Position).Magnitude
                distanceLabel.Text = math.floor(distance) .. " studs"
            else
                if distanceConnection then
                    distanceConnection:Disconnect()
                end
            end
        end)
    end
    
    -- Tracers (linhas do centro da tela até o jogador)
    if State.visuals.esp.tracers then
        local tracerLine = Drawing.new("Line")
        tracerLine.Visible = true
        tracerLine.Color = State.visuals.esp.color
        tracerLine.Thickness = 1
        tracerLine.Transparency = 1
        
        local tracerConnection
        tracerConnection = RunService.RenderStepped:Connect(function()
            if hrpTarget and hrpTarget.Parent then
                local pos, onScreen = camera:WorldToViewportPoint(hrpTarget.Position)
                
                if onScreen then
                    tracerLine.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                    tracerLine.To = Vector2.new(pos.X, pos.Y)
                    tracerLine.Visible = true
                else
                    tracerLine.Visible = false
                end
            else
                tracerLine.Visible = false
                if tracerConnection then
                    tracerConnection:Disconnect()
                end
                tracerLine:Remove()
            end
        end)
    end
    
    -- Boxes (caixas 2D ao redor do jogador)
    if State.visuals.esp.boxes then
        local box = Drawing.new("Square")
        box.Visible = true
        box.Color = State.visuals.esp.color
        box.Thickness = 2
        box.Transparency = 1
        box.Filled = false
        
        local boxConnection
        boxConnection = RunService.RenderStepped:Connect(function()
            if hrpTarget and hrpTarget.Parent then
                local pos, onScreen = camera:WorldToViewportPoint(hrpTarget.Position)
                
                if onScreen then
                    local size = (camera:WorldToViewportPoint(hrpTarget.Position - Vector3.new(0, 3, 0))).Y - (camera:WorldToViewportPoint(hrpTarget.Position + Vector3.new(0, 2.6, 0))).Y
                    
                    box.Size = Vector2.new(size * 1.5, size)
                    box.Position = Vector2.new(pos.X - size * 0.75, pos.Y - size * 0.5)
                    box.Visible = true
                else
                    box.Visible = false
                end
            else
                box.Visible = false
                if boxConnection then
                    boxConnection:Disconnect()
                end
                box:Remove()
            end
        end)
    end
    
    return {
        highlight = highlight,
        billboard = billboard,
        targetPlayer = targetPlayer
    }
end

