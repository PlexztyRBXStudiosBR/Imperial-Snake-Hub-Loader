-- SEÇÃO 5: FUNÇÕES DE MORPH
-- ════════════════════════════════════════════════════════════════════════════

local function aplicarMorph(char, morphData)
    if not char or not char:FindFirstChildOfClass("Humanoid") then return false end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    -- Verificar cooldown
    if tick() - StateManager.lastMorphTime < StateManager.morphCooldown then
        return false
    end
    
    StateManager.lastMorphTime = tick()
    
    local desc = Instance.new("HumanoidDescription")
    
    -- Aplicar Shirt
    if morphData.shirtId and morphData.shirtId ~= 0 then
        desc.Shirt = morphData.shirtId
    end
    
    -- Aplicar Pants
    if morphData.pantsId and morphData.pantsId ~= 0 then
        desc.Pants = morphData.pantsId
    end
    
    -- Aplicar Face
    if morphData.faceId and morphData.faceId ~= 0 then
        desc.Face = morphData.faceId
    end
    
    -- Aplicar Acessórios
    if morphData.hats and morphData.hats ~= "" then
        desc.HatAccessory = morphData.hats
    end
    
    if morphData.hair and morphData.hair ~= "" then
        desc.HairAccessory = morphData.hair
    end
    
    if morphData.back and morphData.back ~= "" then
        desc.BackAccessory = morphData.back
    end
    
    if morphData.neck and morphData.neck ~= "" then
        desc.NeckAccessory = morphData.neck
    end
    
    if morphData.front and morphData.front ~= "" then
        desc.FrontAccessory = morphData.front
    end
    
    if morphData.waist and morphData.waist ~= "" then
        desc.WaistAccessory = morphData.waist
    end
    
    if morphData.shoulders and morphData.shoulders ~= "" then
        desc.ShouldersAccessory = morphData.shoulders
    end
    
    -- Aplicar cores
    if morphData.headColor then
        desc.HeadColor = morphData.headColor
        desc.TorsoColor = morphData.torsoColor or morphData.headColor
        desc.LeftArmColor = morphData.armColor or morphData.headColor
        desc.RightArmColor = morphData.armColor or morphData.headColor
        desc.LeftLegColor = morphData.legColor or morphData.headColor
        desc.RightLegColor = morphData.legColor or morphData.headColor
    end
    
    -- Aplicar escalas
    if morphData.headScale then
        desc.HeadScale = math.clamp(morphData.headScale, 0.5, 1.5)
    end
    
    if morphData.heightScale then
        desc.HeightScale = math.clamp(morphData.heightScale, 0.5, 1.5)
    end
    
    if morphData.widthScale then
        desc.WidthScale = math.clamp(morphData.widthScale, 0.5, 1.5)
    end
    
    if morphData.depthScale then
        desc.DepthScale = math.clamp(morphData.depthScale, 0.5, 1.5)
    end
    
    -- Aplicar animações
    if morphData.idleAnim and morphData.idleAnim ~= 0 then
        desc.IdleAnimation = morphData.idleAnim
    end
    
    if morphData.walkAnim and morphData.walkAnim ~= 0 then
        desc.WalkAnimation = morphData.walkAnim
    end
    
    if morphData.runAnim and morphData.runAnim ~= 0 then
        desc.RunAnimation = morphData.runAnim
    end
    
    if morphData.jumpAnim and morphData.jumpAnim ~= 0 then
        desc.JumpAnimation = morphData.jumpAnim
    end
    
    if morphData.fallAnim and morphData.fallAnim ~= 0 then
        desc.FallAnimation = morphData.fallAnim
    end
    
    if morphData.swimAnim and morphData.swimAnim ~= 0 then
        desc.SwimAnimation = morphData.swimAnim
    end
    
    if morphData.climbAnim and morphData.climbAnim ~= 0 then
        desc.ClimbAnimation = morphData.climbAnim
    end
    
    -- Aplicar
    local sucesso = pcall(function()
        humanoid:ApplyDescription(desc)
    end)
    
    if sucesso then
        StateManager.morphAtivo = morphData.name or "Custom"
    end
    
    return sucesso
end

